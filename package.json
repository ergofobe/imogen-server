{
  "name": "imogen-server",
  "version": "0.6.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "dev": "bun run --filter '@imogen/server' dev",
    "build": "bun run --filter '*' build",
    "test": "bun test",
    "typecheck": "bun run typecheck:packages",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "db:generate": "bun run --filter '@imogen/server' db:generate",
    "db:migrate": "bun run --filter '@imogen/server' db:migrate",
    "typecheck:packages": "tsc -p packages/server && tsc -p packages/mcp",
    "verify": "bun run lint && bun run typecheck && bun test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@types/bun": "^1.2.20",
    "typescript": "^5.9.2"
  },
  "trustedDependencies": [
    "onnxruntime-node"
  ],
  "overrides": {
    "@imogen/shared": "git+https://github.com/ergofobe/imogen-common.git#v0.5.1",
    "@imogen/sdk": "file:imogen-sdk/typescript/packages/sdk"
  }
}
